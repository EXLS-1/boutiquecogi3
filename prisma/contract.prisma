}

model ProductTypeConfig {
  id                       String   @id @default(uuid(7)) @db.Uuid
  type                     String   @unique
  label                    String
  description              String?
  whoCanCreate             String[]
  whoCanEdit               String[]
  whoCanDelete             String[]
