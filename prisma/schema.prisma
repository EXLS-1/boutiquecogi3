// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// MODÈLES D'AUTHENTIFICATION (BetterAuth)
// ==========================================
model User {
  id               String      @id @unique @default(uuid()) @db.Uuid
  name             String?
  email            String?     @unique
  emailVerified    DateTime?
  password         String?     @db.Text
  image            String?
  role             Role        @default(USER)
  sessions         Session[]
  accounts         Account[]
  orders           Order[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  posts            Post[]
  dashboards       dashboard[]
  wishlist         Wishlist?
  twoFactorEnabled Boolean     @default(false)
  twoFactorSecret  String?     @db.Text

  reviews   Review[]
  deletedAt DateTime?

  addresses          Address[]
  couponUsages       CouponUsage[]
  notifications      Notification[]
  carts              Cart?
  twoFactor          TwoFactor[]
  notificationQueues NotificationQueue[]
  abandonedCarts     AbandonedCart[]
  searchAnalytics    SearchAnalytics[]

  @@index([email])
  // Relation avec
  @@map("user")
}

model TwoFactor {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  secret String @db.Text

  enabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  backupCodes TwoFactorBackupCode[]
}

model TwoFactorBackupCode {
  id String @id @default(uuid()) @db.Uuid

  twoFactorId String    @db.Uuid
  twoFactor   TwoFactor @relation(fields: [twoFactorId], references: [id], onDelete: Cascade)

  codeHash String
  used     Boolean @default(false)
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  userId    String
  content   String?
  published Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ipAddress    String?
  userAgent    String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

enum Role {
  USER
  ADMIN
}

model VerificationToken {
  identifier String
  token      String           @unique
  type       VerificationType

  expires    DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([identifier, token])
  @@map("verification_token")
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MAGIC_LINK
  TWO_FACTOR
}

model dashboard {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?
  action     String
  entity     String? // The name of the entity (e.g., "Product", "Order")
  entityType String? // The type of the entity (e.g., "Product", "Order")
  entityId   String?
  newValue   Json?
  oldValue   Json? // The old value of the entity before the action (for updates)
  metadata   Json?
  ip         String?
  userAgent  String?
  location   String? // Geographical location of the action  
  browser    String?
  os         String? // Operating System of the user
  device     String? // Device type (e.g., "Mobile", "Desktop", "Tablet")
  referrer   String? // The referring URL
  screenRes  String? // Screen resolution of the user's device
  duration   Int? // Duration of the action in milliseconds
  status     String? // Status of the action (e.g., "success", "failed")
  error      String? // Error message if the action failed
  payload    Json? // Additional data related to the action
  response   Json? // Response data from the action (e.g., API response)
  context    Json? // Additional context for the action (e.g., request headers, query params)
  sessionId  String? // Session ID if available 
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ==========================================
// --- ADRESSES UTILISATEURS ---
// ==========================================
model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String? // Ex: "Domicile", "Bureau"
  street    String
  commune   String // Indispensable pour la tarification locale
  city      String   @default("Kinshasa")
  country   String   @default("RDC")
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("address")
}

// ==========================================
// PRODUITS & CATALOGUE
// ==========================================

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  slug           String    @unique // Obligatoire pour le SEO et le routage
  description    String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
  deletedAt      DateTime?
  seoTitle       String?
  seoDescription String?

  @@unique([name])
  @@index([slug])
  @@map("category")
}

model Product {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  slug        String @unique // Indispensable pour des URLs propres
  description String @db.Text
  basePrice   Int // Toujours stocker la valeur absolue la plus petite (ex: centimes USD ou unité CDF)
  currency    String @default("USD") @db.VarChar(3) // USD ou CDF

  isFeatured     Boolean       @default(false)
  isArchived     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isdeleted      Boolean       @default(false)
  deletedAt      DateTime?
  status         ProductStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?       @db.Text
  categoryId     String?       @db.Uuid
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants               ProductVariant[]
  wishlistItems          WishlistItem[]
  inventoryLedger        InventoryTransaction[]
  productImages          ProductImage[]
  productOptions         ProductOption[]
  productTags            ProductTag[]
  productAttributeValues ProductAttributeValue[]
  productReviews         Review[]
  taxClass               TaxClass?               @relation(fields: [taxClassId], references: [id])
  taxClassId             String?                 @db.Uuid

  salePrice          Int?
  saleStart          DateTime?
  saleEnd            DateTime?
  inventorySnapshots InventorySnapshot[]

  @@index([categoryId, isArchived, basePrice])
  @@index([slug])
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String   @unique // Stock Keeping Unit : Obligatoire pour la gestion d'entrepôt
  attributes  Json // Ex: {"taille": "XL", "couleur": "Rouge"} -> Plus flexible que ProductOption
  priceOffset Int      @default(0) // Différence de prix par rapport au produit de base
  createdAt   DateTime @default(now())

  orderItems            OrderItem[]
  cartItems             CartItem[]
  inventoryTransactions InventoryTransaction[]
  inventorySnapshots    InventorySnapshot[]
  stockReservations     StockReservation[]

  @@index([productId])
  @@map("productvariant")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
  @@map("productimage")
}

model ProductOption {
  id        String  @id @default(uuid()) @db.Uuid
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String

  @@unique([productId, name, value])
  @@index([productId])
  @@map("productoption")
}

model Tag {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique

  products ProductTag[]

  @@map("tag")
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("producttag")
}

model ProductAttribute {
  id     String                  @id @default(uuid()) @db.Uuid
  name   String                  @unique
  type   String // "text", "number", "boolean", "select"
  values ProductAttributeValue[]

  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String           @id @default(uuid()) @db.Uuid
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String

  @@unique([productId, attributeId])
  @@map("product_attribute_values")
}

model Review {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @db.Uuid
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String   @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int      @db.SmallInt // Optimisation de l'espace
  comment            String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isVerifiedPurchase Boolean  @default(false) // Indique si l'avis provient d'un acheteur vérifié

  @@unique([productId, userId])
  @@index([productId, rating]) // Pour calculer/afficher rapidement les notes
  @@map("reviews")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

model Product_Availability_Projection {
  productId   String   @id @db.Uuid
  isAvailable Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("product_availability_projection")
}

model ProductPrice {
  id             String    @id @default(uuid()) @db.Uuid
  productId      String    @db.Uuid
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency       String
  amount         Int
  compareAtPrice Int?
  country        String?
  region         String?
  startsAt       DateTime?
  endsAt         DateTime?
}

// ==========================================
// TAXES
// ==========================================

model TaxClass {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  products    Product[]
  taxRates    TaxRate[]

  @@map("tax_classes")
}

model TaxRate {
  id         String   @id @default(uuid()) @db.Uuid
  taxClassId String   @db.Uuid
  taxClass   TaxClass @relation(fields: [taxClassId], references: [id], onDelete: Cascade)
  country    String   @default("RDC")
  region     String? // Ex: "Kinshasa", "Haut-Katanga 
  rate       Decimal  @db.Decimal(5, 4) // Ex: 0.16 pour 16%
  // Exemple: Une taxe de 16% pour la classe "Standard" en RDC, province du "Haut-Katanga". Si `region` est null, la taxe s'applique à tout le pays. Le `unique` garantit qu'il n'y a pas de doublons. Notez que `region` peut être null.

  @@unique([taxClassId, country, region]) // Une seule taxe par classe/pays/région
  @@index([taxClassId])
  @@index([country, region])
  @@index([country, region, taxClassId]) // Pour des recherches rapides de taxes applicables 
  @@map("tax_rates")
}

// ==========================================
// INVENTAIRE
// ==========================================
// --- GESTION DES STOCKS (Event Sourcing Ledger) ---
// Au lieu de mettre à jour un simple chiffre, on trace chaque mouvement.
// Le stock réel est la somme de ces transactions. C'est la seule méthode robuste.
model InventoryTransaction {
  id          String          @id @default(uuid()) @db.Uuid
  productId   String          @db.Uuid
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?         @db.Uuid // Nullable si le produit n'a pas de variante
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int // Positif (ajout) ou Négatif (vente/perte)
  reason      TransactionType
  referenceId String? // ID de la commande si reason == SALE
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  performedBy String?         @db.Uuid // ID de l'utilisateur qui a effectué la transaction (ex: admin, système, etc.)
  warehouseId String?

  @@unique([productId, variantId, reason, referenceId])
  @@index([productId, variantId, createdAt, performedBy])
  @@map("inventory_transaction")
}

enum TransactionType {
  RESTOCK
  SALE
  RETURN
  SHRINKAGE // Perte, vol, casse
}

model InventorySnapshot {
  id          String          @id @default(uuid()) @db.Uuid
  productId   String          @db.Uuid
  variantId   String?         @db.Uuid
  available   Int             @default(0)
  reserved    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  warehouseId String?

  @@unique([productId, variantId])
  @@index([createdAt])
  @@index([productId])
  @@index([productId, variantId])
  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([updatedAt])
}

// ==========================================
// PANIER, COMMANDES ET LOGISTIQUE
// ==========================================

model Cart {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String? @unique @db.Uuid
  sessionToken String? @unique

  items          CartItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  expiresAt      DateTime
  user           User?            @relation(fields: [userId], references: [id])
  abandonedCarts Abandoned_Cart[]

  @@unique([userId]) // Index pour les recherches par utilisateur
  @@unique([sessionToken]) // Index pour les recherches par session
  @@index([expiresAt])
  @@map("cart")
}

model CartItem {
  id                 String         @id @default(uuid()) @db.Uuid
  cartId             String         @db.Uuid
  cart               Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId          String         @db.Uuid
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity           Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  snapshotPriceAtAdd Json? // Capture le prix et la devise au moment de l'ajout au panier

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_item")
}

model Order {
  id          String  @id @default(uuid()) @db.Uuid
  orderNumber String  @unique // Identifiant lisible par l'humain (ex: COGI-2026-001)
  userId      String? @db.Uuid
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status         OrderStatus @default(PENDING) // Statut actuel de la commande
  totalAmount    Int
  subtotalAmount Int
  taxAmount      Int
  discountAmount Int
  grandTotal     Int
  currency       String      @default("USD") @db.VarChar(3) // USD ou CDF

  // Facturation
  billingMethodId String?        @db.Uuid
  billingMethod   billingMethod? @relation(fields: [billingMethodId], references: [id])

  // Expédition
  shippingMethodId String?         @db.Uuid
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  shippingCost     Int             @default(0)
  trackingNumber   String?

  // Facturation
  cinetpayTransId String? @unique // Remplacé stripeSessionId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                OrderItem[]
  payments             Payment[]
  shipment             Shipment?
  orderStatusHistories OrderStatusHistory[]
  couponUsage          CouponUsage?
  giftCardRedemptions  GiftCardRedemption[]
  returns              Return[]
  refundItems          RefundItem[]
  orderAddresses       OrderAddress[]
  stockReservations    StockReservation[]
  coupon               Coupon?              @relation(fields: [couponId], references: [id])
  couponId             String?              @db.Uuid
  invoice              Invoice?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model billingMethod {
  id     String  @id @default(uuid()) @db.Uuid
  name   String
  orders Order[]

  paymentMethod String? // M-Pesa, Orange Money, etc.
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  requestHash String
  response    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AbandonedCart {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTi
  cartId    String   @unique @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAtme
}

model OrderItem {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @db.Uuid
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName    String
  variantSku     String
  productImage   String?
  attributes     Json?
  taxAmount      Int?
  discountAmount Int?
  currency       String?
  exchangeRate   Decimal?       @db.Decimal(10, 4)
  variantId      String         @db.Uuid
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPrice      Int // Prix unitaire figé au moment de l'achat
  subtotal       Int // unitPrice * quantity
  returnItems    ReturnItem[]

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderAddress {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  street    String
  commune   String
  city      String   @default("Kinshasa")
  country   String   @default("RDC")
  phone     String
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_addresses")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model StockReservation {
  id        String         @id @default(uuid()) @db.Uuid
  orderId   String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  expiresAt DateTime
  createdAt DateTime       @default(now())
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Carrier {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  code      String     @unique // Ex: "DHL", "FEDEX", "POSTE_RDC"
  contact   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shipments Shipment[]
}

// ==========================================
// EXPÉDITION
// ==========================================

model Shipment {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @unique @db.Uuid
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrierId        String?
  carrier          Carrier?       @relation(fields: [carrierId], references: [id])
  trackingNumber   String?        @unique
  status           ShipmentStatus @default(PENDING)
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  shippingMethodId String?        @db.Uuid
}

model ShippingMethod {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  price         Int // centimes
  freeShipping  Boolean @default(false)
  minAmount     Int? // montant minimum pour la gratuité (centimes)
  carrier       String?
  estimatedDays String?
  isActive      Boolean @default(true)
  orders        Order[]

  @@map("shipping_methods")
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  EXCEPTION // Problème de livraison
}

// ==========================================
// PAIEMENTS
// ==========================================

model Payment {
  id       String @id @default(uuid()) @db.Uuid
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount   Int // centimes
  currency String @default("USD") @db.VarChar(3) // USD ou CDF

  status        PaymentStatus      @default(PENDING)
  transactionId String?            @unique
  paidAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  attempts      PaymentAttempt[]
  refund        Refund?
  method        PaymentMethodType? @default(CINETPAY) // "cinetpay", "mpesa", "orange_money", et autres méthodes de paiement

  @@index([orderId])
  @@map("payment")
}

model PaymentAttempt {
  id        String             @id @default(uuid()) @db.Uuid
  paymentId String             @db.Uuid
  payment   Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount    Int // Montant de la tentative (peut être différent du montant total du paiement)
  status    PaymentStatus      @default(PENDING)
  method    PaymentMethodType? // Méthode utilisée pour cette tentative (ex: "CinetPay", "Stripe")
  createdAt DateTime           @default(now())

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethodType {
  CINETPAY
  MPESA
  ORANGE_MONEY
  AIRTEL_MONEY
  CASH_ON_DELIVERY
}

model PaymentWebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  error       String?   @db.Text
  signature   String?
  verified    Boolean   @default(false)
  processedAt DateTime?

  @@index([provider, eventType])
}

// ==========================================
// RETOURS
// ==========================================

model Return {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason      String
  status      ReturnStatus @default(REQUESTED)
  requestedAt DateTime     @default(now())
  resolvedAt  DateTime?

  returnItems ReturnItem[]
}

model ReturnItem {
  id          String       @id @default(uuid()) @db.Uuid
  returnId    String
  return      Return       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int          @default(1)
  reason      String
  status      ReturnStatus @default(REQUESTED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([returnId])
  @@index([orderItemId])
  @@map("return_item")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  paymentId   String       @db.Uuid
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String?
  status      RefundStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  refundItems RefundItem[]

  @@unique([paymentId])
}

model RefundItem {
  id        String       @id @default(uuid()) @db.Uuid
  refundId  String       @db.Uuid
  refund    Refund       @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderId   String       @db.Uuid
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity  Int          @default(1)
  reason    String?
  status    RefundStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([refundId])
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

// ==========================================
// PROMOTIONS & FIDÉLITÉ (Coupons, Cartes Cadeaux, Programmes de Fidélité, Points de Fidélité, Récompenses, Parrainage, Abonnements, Niveaux de Fidélité, Historique de Fidélité, Avantages Exclusifs)
// ==========================================
model Coupon {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  discountType  DiscountType
  discountValue Int // Soit un pourcentage, soit un montant fixe
  minOrderValue Int? // Montant minimum d'achat pour que le coupon soit valide
  expiresAt     DateTime
  isActive      Boolean      @default(true)
  usageLimit    Int?
  usageCount    Int          @default(0)
  createdAt     DateTime     @default(now())

  orders       Order[]
  couponUsages CouponUsage[]
}

model CouponUsage {
  id       String   @id @default(uuid()) @db.Uuid
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId  String   @unique
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usedAt   DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// ==========================================
// CARTES CADEAUX
// ==========================================

model GiftCard {
  id             String               @id @default(uuid()) @db.Uuid
  code           String               @unique
  initialBalance Int // centimes
  balance        Int
  expiresAt      DateTime?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  redemptions    GiftCardRedemption[]

  @@map("gift_cards")
}

model GiftCardRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Int // centimes utilisés
  createdAt  DateTime @default(now())

  @@index([giftCardId])
  @@map("gift_card_redemptions")
}

// ==========================================
// AVIS & SOUHAITS
// ==========================================

model Wishlist {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     WishlistItem[]

  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // ex: "order_confirmed", "shipped", "promo"
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model Warehouse {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  location       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  purchaseOrders Purchase_order[]
}

model Supplier {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  contact        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  purchaseOrders Purchase_order[]
}

model NotificationTemplate {
  id      String @id @default(uuid()) @db.Uuid
  name    String @unique
  subject String
  body    String @db.Text
  vars    Json? // variables disponibles pour le template

  @@map("notification_templates")
}

model NotificationQueue {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String // e.g., "email", "sms", "push"
  payload   Json // Content of the notification
  status    String // e.g., "pending", "sent", "failed"
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrder {
  id          String    @id @default(uuid()) @db.Uuid
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum SupplierType {
  LOCAL
  INTERNATIONAL
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @db.Uuid
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique
  issueDate     DateTime @default(now())
  dueDate       DateTime
  amountDue     Int
  status        String // e.g., "Paid", "Pending", "Overdue"
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SearchAnalytics {
  id        String   @id @default(uuid()) @db.Uuid
  query     String
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
