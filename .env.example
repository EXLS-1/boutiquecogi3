# Local PostgreSQL configuration for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# Optional remote PostgreSQL example
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Application settings
CRON_SECRET="replace-with-a-secure-secret"
CRON_JOB_API_KEY="replace-with-a-cron-api-key"
APP_URL="http://localhost:3000"
EXCHANGE_RATE_CDF="2400"
BETTER_AUTH_SECRET="replace-with-a-secure-secret"
BETTER_AUTH_URL="http://localhost:3000"
