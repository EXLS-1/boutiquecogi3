# =============================================================================
# Boutique COGI — .env.example
# -----------------------------------------------------------------------------
# Gabarit de référence (COMMITABLE, aucun secret réel).
#   copy .env.example .env        (Windows)
#   cp   .env.example .env        (Unix)
# puis renseignez les valeurs. Les secrets peuvent être placés dans `.env.local`
# (prioritaire sur `.env`).
#
# Liste exhaustive des variables lues par le code (vérifiée dans le dépôt).
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Boutiquecogi3"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Boutiquecogi3"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_COOKIE_PREFIX="better-auth"

# --- Base de données (PostgreSQL / Prisma) -----------------------------------
# ⚠️  REMPLACEZ « USER / PASSWORD / HOST » : un gabarit laissé tel quel (ex. `aws-0-<REGION>`)
#     rend la chaîne inanalysable — `pg` échoue alors sur « Invalid URL »
#     (ERR_INVALID_URL) à la première requête Prisma. Vérifiez avec : npm run db:check
#
# Supabase : Project Settings → Database → Connection string
#   DATABASE_URL → pooler « transaction » : port 6543 … ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   → pooler « session »     : port 5432   (utilisée par l'adaptateur Prisma)
#   Hôte du pooler : aws-0-<region>.pooler.supabase.com (région visible dans le dashboard)
# Postgres local (docker-compose.yml) : voir les deux lignes commentées plus bas.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"
DATABASE_SSL="false"
PG_POOL_MAX="20"
PG_IDLE_TIMEOUT_MS="30000"
# PGSSLMODE="require"
# POSTGRES_SSL="true"

# --- Taux de change (OBLIGATOIRE : 1 USD = X CDF, bornes 2100 → 3500) --------
EXCHANGE_RATE_CDF="2850"

# --- Better Auth -------------------------------------------------------------
BETTER_AUTH_SECRET="<32+ caractères aléatoires>"
# Secret partagé des appels internes (/api/auditlog → x-internal-secret)
AUTH_SECRET="<32+ caractères aléatoires>"
# OAuth (optionnels — désactivés si vides)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- 2FA / PIN super-admin ---------------------------------------------------
TWOFA_COOKIE_SECRET="<base64 encodant 32 octets>"
TWOFA_ENCRYPTION_KEY="<32+ caractères>"
ADMIN_PIN_COOKIE_SECRET="<32+ caractères>"
ADMIN_PIN="<6 caractères, alphanumérique + spécial>"
ADMIN_PIN_ENABLED="true"

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<ref-projet>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<clé publique>"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<clé publique>"
SUPABASE_SERVICE_KEY="<clé service_role — serveur uniquement>"
SUPABASE_SERVICE_ROLE_KEY="<clé service_role — alias README>"
SUPABASE_URL="https://storage.boutiquecogi3.cd"

# --- Emails transactionnels (Resend) ----------------------------------------
RESEND_API_KEY="<clé Resend>"
MAIL_FROM="Boutiquecogi3 <noreply@boutiquecogi3.com>"
FROM_EMAIL="security@boutiquecogi3.com"
MAIL_RATE_LIMIT_PER_HOUR="50"

# --- Vérification email Better Auth (Gmail SMTP) -----------------------------
# Passez à true seulement après avoir créé un mot de passe d'application Gmail
# (Google Account → Sécurité → Validation en deux étapes → Mots de passe des applications).
EMAIL_VERIFICATION_REQUIRED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="excellentservice1exls@gmail.com"
SMTP_APP_PASSWORD=""

# --- CinetPay (les 3 sont obligatoires) --------------------------------------
CINETPAY_API_KEY="<clé API>"
CINETPAY_SITE_ID="<site id>"
CINETPAY_WEBHOOK_SECRET="<secret webhook>"

# --- CRON (cron-job.org / Vercel Cron) ---------------------------------------
CRON_SECRET="<32+ caractères>"
CRON_JOB_API_KEY="<clé API cron-job.org>"

# --- SUPER_ADMIN (seeds / scripts) -------------------------------------------
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="SuperAdmin COGI"
INITIAL_SUPERADMIN_EMAIL=""
INITIAL_SUPERADMIN_PASSWORD=""
INITIAL_SUPERADMIN_NAME="SuperAdmin COGI3"

# --- Redis (ioredis) ---------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_PASSWORD=""
REDIS_KEY_PREFIX="boutiquecogi3:"
REDIS_MAX_RETRIES="3"
REDIS_ENABLE_READY_CHECK="true"
REDIS_ENABLE_OFFLINE_QUEUE="true"
REDIS_CONNECT_TIMEOUT="2000"
REDIS_COMMAND_TIMEOUT="2000"
REDIS_KEEP_ALIVE="30000"
REDIS_FAMILY="4"
REDIS_TLS="false"
REDIS_TLS_REJECT_UNAUTHORIZED="true"
REDIS_ENABLE_AUTO_PIPELINING="false"
# --- Cluster Redis (actif si REDIS_CLUSTER_ENABLED="true") -------------------
REDIS_CLUSTER_ENABLED="false"
REDIS_CLUSTER_NODES=""
REDIS_CLUSTER_MAX_REDIRECTIONS="16"
REDIS_CLUSTER_RETRY_DELAY="300"
REDIS_CLUSTER_DOWN_DELAY="300"
REDIS_CLUSTER_OFFLINE_QUEUE="true"
REDIS_CLUSTER_SCALE_READS="master"

# --- Upstash Redis (rate limit + cache RBAC + audit) -------------------------
# Vides → repli mémoire + logs console (dégradation propre).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
UPSTASH_TIMEOUT_MS="2000"
RBAC_CACHE_TTL_SECONDS="60"

# --- Logs (lib/logger.ts) ----------------------------------------------------
LOG_LEVEL="info"
LOG_FORMAT="pretty"
LOG_CONSOLE="true"
LOG_STACK_TRACE="true"
LOG_SANITIZE="true"
LOG_PREFIX="Boutiquecogi3"
