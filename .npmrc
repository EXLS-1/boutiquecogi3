# Réseau lent ou instable (ECONNRESET / délais très longs constatés sur registry.npmjs.org).
# Ces réglages sont repris par `npm i`, `npm ci` et `npm run postinstall` sans flag supplémentaire.

# Réessais automatiques en cas de coupure de connexion
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=300000

# Timeout de téléchargement large (une tarball peut mettre plusieurs minutes sur ce réseau)
fetch-timeout=900000

# Privilégier le cache local avant de retélécharger : installations répétées beaucoup plus rapides
prefer-offline=true
